---
import styles from '../styles/upload.module.css';

const pageTitle = 'MapDataStructures';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <h1>{pageTitle}</h1>
      <p>
        Choose a JSON file that describes a system and its drawing appears below. The file
        is read in your browser and is never sent anywhere.
      </p>

      <div id="drop-zone" class={styles.dropZone} data-dragging="false">
        <p class={styles.field}>
          <label for="design-file">Design JSON file</label>
          <input
            id="design-file"
            type="file"
            accept="application/json,.json"
            aria-describedby="drop-hint"
          />
        </p>
        <p id="drop-hint" class={styles.hint}>
          Or drag a JSON file onto this page from anywhere on your desktop.
        </p>
      </div>

      <p id="upload-status" role="status"></p>

      <div id="drawing"></div>
    </main>

    <script>
      import { describeUpload } from '../lib/describeUpload';
      import type { Design, DesignEdge, DesignNode } from '../lib/design.types';
      import { loadDesign } from '../lib/loadDesign';

      const SVG_NAMESPACE = 'http://www.w3.org/2000/svg';
      const BOX_WIDTH = 160;
      const BOX_HEIGHT = 64;
      const BOX_GAP = 56;
      const MARGIN = 24;

      interface Point {
        readonly x: number;
        readonly y: number;
      }

      interface PageElements {
        readonly fileInput: HTMLInputElement;
        readonly dropZone: HTMLElement;
        readonly status: HTMLElement;
        readonly drawing: HTMLElement;
      }

      /**
       * Choose a file or drop one on the page, read it here in the browser, say
       * what it holds, and draw a box per node and a line per edge. Placement is
       * a single row; Task 03 replaces it with a real layout.
       *
       * Nothing with logic in it lives in this script: no test and, until D17
       * closes, no type-checker can see in here. Validating is `loadDesign`'s
       * and counting is `describeUpload`'s, both in `src/lib`, both tested.
       */
      function startUploadPage(): void {
        const elements = findPageElements();

        elements.fileInput.addEventListener('change', () => {
          void showFile(elements.fileInput.files?.[0], elements);
        });

        watchForDroppedFiles(elements);
      }

      function findPageElements(): PageElements {
        const fileInput = document.querySelector('#design-file');
        const dropZone = document.querySelector('#drop-zone');
        const status = document.querySelector('#upload-status');
        const drawing = document.querySelector('#drawing');

        if (
          !(fileInput instanceof HTMLInputElement) ||
          !(dropZone instanceof HTMLElement) ||
          !(status instanceof HTMLElement) ||
          !(drawing instanceof HTMLElement)
        ) {
          throw new Error('The upload page is missing one of its elements.');
        }

        return { fileInput, dropZone, status, drawing };
      }

      /**
       * Drag-and-drop, as an addition to the file input and never as a
       * replacement for it: the input stays the keyboard's way in.
       *
       * Both `dragover` and `drop` must have their default prevented. A browser
       * whose default runs navigates away to the dropped file, which throws the
       * page away and, with it, the promise that the file never leaves here.
       */
      function watchForDroppedFiles(elements: PageElements): void {
        document.addEventListener('dragover', (event) => {
          event.preventDefault();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = 'copy';
          }
          setDragging(elements, true);
        });

        // A `dragleave` with nothing behind it is the pointer leaving the
        // window; every other one is it crossing between elements inside it.
        document.addEventListener('dragleave', (event) => {
          if (event.relatedTarget === null) {
            setDragging(elements, false);
          }
        });

        document.addEventListener('drop', (event) => {
          event.preventDefault();
          setDragging(elements, false);
          void showFile(event.dataTransfer?.files?.[0], elements);
        });
      }

      /** Marks the drop zone, and only when the state actually changed. */
      function setDragging(elements: PageElements, isDragging: boolean): void {
        const value = String(isDragging);

        if (elements.dropZone.dataset.dragging !== value) {
          elements.dropZone.dataset.dragging = value;
        }
      }

      async function showFile(
        file: File | undefined,
        elements: PageElements,
      ): Promise<void> {
        if (!file) {
          return;
        }

        try {
          const design = loadDesign(await file.text());
          elements.drawing.replaceChildren(renderDesign(design));
          elements.status.textContent = describeUpload(file.name, design);
        } catch (error) {
          // Never leave a failure silent. Task 04 replaces this one line with
          // messages that name the line or the field at fault, out of the
          // position and issue paths the error still carries.
          elements.drawing.replaceChildren();
          elements.status.textContent = `That file could not be drawn: ${describe(error)}`;
        }
      }

      function renderDesign(design: Design): SVGElement {
        const svg = createSvgElement('svg', {
          width: String(svgWidthFor(design.nodes.length)),
          height: String(MARGIN * 2 + BOX_HEIGHT),
          role: 'img',
          'aria-label': `Drawing of ${design.title}`,
        });

        const title = createSvgElement('title', {});
        title.textContent = design.title;
        svg.append(title);

        // Edges first, so the boxes sit over the lines rather than under them.
        const origins = originsByNodeId(design.nodes);
        for (const edge of design.edges) {
          svg.append(renderEdge(edge, origins));
        }
        for (const [index, node] of design.nodes.entries()) {
          svg.append(...renderNode(node, boxOriginOf(index)));
        }

        return svg;
      }

      function renderNode(node: DesignNode, origin: Point): readonly SVGElement[] {
        const box = createSvgElement('rect', {
          x: String(origin.x),
          y: String(origin.y),
          width: String(BOX_WIDTH),
          height: String(BOX_HEIGHT),
          fill: 'none',
          stroke: 'currentColor',
        });

        const label = createSvgElement('text', {
          x: String(origin.x + BOX_WIDTH / 2),
          y: String(origin.y + BOX_HEIGHT / 2),
          'text-anchor': 'middle',
          'dominant-baseline': 'middle',
          fill: 'currentColor',
        });
        label.textContent = node.label;

        return [box, label];
      }

      function renderEdge(
        edge: DesignEdge,
        origins: ReadonlyMap<string, Point>,
      ): SVGElement {
        const from = origins.get(edge.from);
        const to = origins.get(edge.to);

        if (!from || !to) {
          throw new Error('an edge names a node the file does not define');
        }

        return createSvgElement('line', {
          x1: String(from.x + BOX_WIDTH),
          y1: String(from.y + BOX_HEIGHT / 2),
          x2: String(to.x),
          y2: String(to.y + BOX_HEIGHT / 2),
          stroke: 'currentColor',
        });
      }

      function originsByNodeId(nodes: readonly DesignNode[]): ReadonlyMap<string, Point> {
        return new Map(nodes.map((node, index) => [node.id, boxOriginOf(index)]));
      }

      function boxOriginOf(index: number): Point {
        return { x: MARGIN + index * (BOX_WIDTH + BOX_GAP), y: MARGIN };
      }

      function svgWidthFor(nodeCount: number): number {
        const boxes = Math.max(nodeCount, 1);
        return MARGIN * 2 + boxes * BOX_WIDTH + (boxes - 1) * BOX_GAP;
      }

      function createSvgElement(
        name: string,
        attributes: Readonly<Record<string, string>>,
      ): SVGElement {
        const element = document.createElementNS(SVG_NAMESPACE, name);

        for (const [attribute, value] of Object.entries(attributes)) {
          element.setAttribute(attribute, value);
        }

        return element;
      }

      function describe(error: unknown): string {
        return error instanceof Error ? error.message : String(error);
      }

      startUploadPage();
    </script>
  </body>
</html>
