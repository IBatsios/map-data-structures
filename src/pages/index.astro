---
import drawingStyles from '../styles/drawing.module.css';
import styles from '../styles/upload.module.css';

const pageTitle = 'MapDataStructures';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <h1>{pageTitle}</h1>
      <p>
        Choose a JSON file that describes a system and its drawing appears below. The file
        is read in your browser and is never sent anywhere.
      </p>

      <div id="drop-zone" class={styles.dropZone} data-dragging="false">
        <p class={styles.field}>
          <label for="design-file">Design JSON file</label>
          <input
            id="design-file"
            type="file"
            accept="application/json,.json"
            aria-describedby="drop-hint"
          />
        </p>
        <p id="drop-hint" class={styles.hint}>
          Or drag a JSON file onto this page from anywhere on your desktop.
        </p>
      </div>

      {/*
       * Both regions are in the page from the first paint and both start
       * empty, because a live region announces changes to itself and not its
       * own arrival: a panel created on failure may say nothing at all.
       *
       * They take turns rather than talk over each other. A good file fills
       * the status line and empties the panel; a bad one fills the panel and
       * empties the status line, so a success sentence is never left sitting
       * above a list of errors. Both are polite `role="status"`, not
       * `role="alert"`: the user asked for this by choosing a file, and the
       * answer is worth waiting a beat for rather than interrupting whatever
       * they were being told.
       */}
      <div
        id="upload-problems"
        class={styles.problems}
        role="status"
        data-state="empty"
      ></div>

      <p id="upload-status" role="status"></p>

      <div id="drawing" class={drawingStyles.drawing}></div>
    </main>

    <script>
      import type { LoadErrorReport } from '../lib/describeLoadError';
      import {
        describeLoadError,
        describeUnsupportedFile,
      } from '../lib/describeLoadError';
      import { describeUpload } from '../lib/describeUpload';
      import { looksLikeJsonFile } from '../lib/jsonFile';
      import { layoutDesign } from '../lib/layout';
      import { loadDesign } from '../lib/loadDesign';
      import { renderDrawing } from '../lib/renderDrawing';
      import { renderProblems } from '../lib/renderProblems';

      interface PageElements {
        readonly fileInput: HTMLInputElement;
        readonly dropZone: HTMLElement;
        readonly status: HTMLElement;
        readonly problems: HTMLElement;
        readonly drawing: HTMLElement;
      }

      /**
       * Choose a file or drop one on the page, read it here in the browser, say
       * what it holds, and draw it.
       *
       * Nothing with logic in it lives in this script. Validating is
       * `loadDesign`'s, placing is `layoutDesign`'s, drawing is
       * `renderDrawing`'s, counting is `describeUpload`'s and every sentence
       * about a file that failed is `describeLoadError`'s — all in `src/lib`,
       * all tested. What is left here is wiring: find the elements, listen, and
       * put the result in the right place.
       */
      function startUploadPage(): void {
        const elements = findPageElements();

        elements.fileInput.addEventListener('change', () => {
          void showFile(elements.fileInput.files?.[0], elements);
        });

        watchForDroppedFiles(elements);
      }

      function findPageElements(): PageElements {
        const fileInput = document.querySelector('#design-file');
        const dropZone = document.querySelector('#drop-zone');
        const status = document.querySelector('#upload-status');
        const problems = document.querySelector('#upload-problems');
        const drawing = document.querySelector('#drawing');

        if (
          !(fileInput instanceof HTMLInputElement) ||
          !(dropZone instanceof HTMLElement) ||
          !(status instanceof HTMLElement) ||
          !(problems instanceof HTMLElement) ||
          !(drawing instanceof HTMLElement)
        ) {
          throw new Error('The upload page is missing one of its elements.');
        }

        return { fileInput, dropZone, status, problems, drawing };
      }

      /**
       * Drag-and-drop, as an addition to the file input and never as a
       * replacement for it: the input stays the keyboard's way in.
       *
       * Both `dragover` and `drop` must have their default prevented. A browser
       * whose default runs navigates away to the dropped file, which throws the
       * page away and, with it, the promise that the file never leaves here.
       */
      function watchForDroppedFiles(elements: PageElements): void {
        document.addEventListener('dragover', (event) => {
          event.preventDefault();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = 'copy';
          }
          setDragging(elements, true);
        });

        // A `dragleave` with nothing behind it is the pointer leaving the
        // window; every other one is it crossing between elements inside it.
        document.addEventListener('dragleave', (event) => {
          if (event.relatedTarget === null) {
            setDragging(elements, false);
          }
        });

        document.addEventListener('drop', (event) => {
          event.preventDefault();
          setDragging(elements, false);
          void showFile(event.dataTransfer?.files?.[0], elements);
        });
      }

      /** Marks the drop zone, and only when the state actually changed. */
      function setDragging(elements: PageElements, isDragging: boolean): void {
        const value = String(isDragging);

        if (elements.dropZone.dataset.dragging !== value) {
          elements.dropZone.dataset.dragging = value;
        }
      }

      async function showFile(
        file: File | undefined,
        elements: PageElements,
      ): Promise<void> {
        if (!file) {
          return;
        }

        try {
          await drawOrExplain(file, elements);
        } finally {
          forgetChosenFile(elements);
        }
      }

      /**
       * One file, one outcome: the drawing, or the reason there isn't one.
       *
       * The kind check comes before the read so a file that is plainly not JSON
       * — a picture dropped on the page, which the input's `accept` never sees
       * — is answered without its bytes ever going near `JSON.parse`. The text
       * is kept because a syntax error's position points into it, and it is
       * read inside the `try` so that a file that vanished between the pick and
       * the read is explained rather than swallowed.
       */
      async function drawOrExplain(file: File, elements: PageElements): Promise<void> {
        if (!looksLikeJsonFile(file.name, file.type)) {
          showProblems(elements, describeUnsupportedFile(file.name));
          return;
        }

        let fileText = '';

        try {
          fileText = await file.text();
          showDrawing(elements, file.name, fileText);
        } catch (error) {
          showProblems(
            elements,
            describeLoadError({ error, fileName: file.name, fileText }),
          );
        }
      }

      /** A good file: the drawing, the count, and the panel emptied. */
      function showDrawing(
        elements: PageElements,
        fileName: string,
        fileText: string,
      ): void {
        const design = loadDesign(fileText);

        elements.problems.dataset.state = 'empty';
        elements.problems.replaceChildren();
        elements.drawing.replaceChildren(renderDrawing(layoutDesign(design), document));
        elements.status.textContent = describeUpload(fileName, design);
      }

      /**
       * A bad file: the messages, and nothing left behind that described the
       * last one. The status line is cleared rather than left saying a drawing
       * is below, because there is no longer a drawing and because two live
       * regions changing at once talk over each other.
       */
      function showProblems(elements: PageElements, report: LoadErrorReport): void {
        elements.status.textContent = '';
        elements.drawing.replaceChildren();
        elements.problems.dataset.state = 'problems';
        elements.problems.replaceChildren(...renderProblems(report, document));
      }

      /**
       * Clears the input's value after every read.
       *
       * Without this, choosing the same file twice fires no `change` event at
       * all — the value has not changed — so a user who edits their JSON and
       * re-picks it sees the old drawing and the old status line, both still
       * claiming to describe the file they just chose. Clearing it makes every
       * pick a change. The file itself is already read by this point, so
       * nothing is lost, and the input still shows no file rather than a stale
       * name.
       */
      function forgetChosenFile(elements: PageElements): void {
        elements.fileInput.value = '';
      }

      startUploadPage();
    </script>
  </body>
</html>
